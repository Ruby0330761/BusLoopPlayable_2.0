node_modules/
dist/
artifacts/playable-exports/
.pnpm-store/
%SystemDrive%/
BusLoopPlayable_new/
*.log

# Local noise and generated build outputs
.DS_Store
server-dist/
__pycache__/

# Scratch diagnostics and one-off pages
*.tmp.mjs
pelican-bike.html
.zcodeignore

# Generated snapshots and exports
artifacts/backups/
artifacts/web-level-backups/
artifacts/level-contact-sheet*.html
artifacts/q24-belt-compare.png
artifacts/busloop-level-editor-*.zip
artifacts/applovin/*.html
!artifacts/applovin/index.html

# Progress-bar art extraction scratch (raw crops, mattes, per-asset checks)
artifacts/progress-ui-extract/

# Editor upload volumes. These are operator-uploaded runtime media the editor
# creates on first upload, not shipped assets: committing them would put one
# machine's uploads into everyone's checkout. `editor-backgrounds/` and
# `editor-prerolls/` stay tracked because they also hold delivered art.
artifacts/editor-bgm/
artifacts/editor-effects/
artifacts/editor-free-assets/
artifacts/editor-banners/

# Packager size report (rewritten on every package:applovin)
artifacts/applovin/*.payload.json
