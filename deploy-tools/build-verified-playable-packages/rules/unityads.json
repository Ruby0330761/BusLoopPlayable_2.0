{
  "schemaVersion": "playable-platform-rules-v1",
  "platform": "unityads",
  "rules": [
    {
      "id": "UNITY-ART-001",
      "title": "交付单个 HTML，禁止 ZIP",
      "stage": "artifact",
      "severity": "blocker",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "artifact_kind",
        "value": "html"
      },
      "repairHint": "使用 UnityAds HTML delivery 构建，不套 ZIP。",
      "autoRepair": false
    },
    {
      "id": "UNITY-ART-002",
      "title": "发布态 HTML 为单行",
      "stage": "artifact",
      "severity": "warning",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "max_newlines",
        "value": 0
      },
      "repairHint": "在 UnityAds 构建步骤执行确定性 minify。（真实 Checker 不阻断；不符合时建议人工确认交付规范。）",
      "autoRepair": false
    },
    {
      "id": "UNITY-ART-003",
      "title": "HTML 严格结束于 </html>",
      "stage": "artifact",
      "severity": "warning",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "strict_html_end"
      },
      "repairHint": "删除 </html> 后的换行、空格、注释和工具标签。（真实 Checker 不阻断；不符合时建议人工确认交付规范。）",
      "autoRepair": false
    },
    {
      "id": "UNITY-ART-004",
      "title": "除容器注入的唯一 mraid.js 声明外，业务内容全部自包含",
      "stage": "artifact",
      "severity": "warning",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "self_contained_html",
        "allow": [
          "mraid.js",
          "./mraid.js"
        ]
      },
      "repairHint": "内联所有业务脚本、样式和资源，只保留精确的 mraid.js 或 ./mraid.js 容器声明；不得放宽其他 URL。（真实 Checker 不阻断；不符合时建议人工确认交付规范。）",
      "autoRepair": false
    },
    {
      "id": "UNITY-STA-001",
      "title": "mraid.js 声明且仅一次",
      "stage": "static",
      "severity": "warning",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "regex_count",
        "target": "main_html",
        "pattern": "<script\\b[^>]*\\bsrc\\s*=\\s*['\\\"](?:\\./)?mraid\\.js(?:[?#][^'\\\"]*)?['\\\"][^>]*>",
        "value": 1
      },
      "repairHint": "在 head 中保留唯一一次 mraid.js 声明。（真实 Checker 不阻断；不符合时建议人工确认交付规范。）",
      "autoRepair": false
    },
    {
      "id": "UNITY-STA-002",
      "title": "MRAID 可见性与尺寸监听完整",
      "stage": "static",
      "severity": "blocker",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "all_regex_present",
        "patterns": [
          "mraid\\.getState\\s*\\(",
          "mraid\\.addEventListener",
          "['\\\"]ready['\\\"]",
          "['\\\"]viewableChange['\\\"]",
          "mraid\\.isViewable\\s*\\(",
          "['\\\"]sizeChange['\\\"]",
          "mraid\\.open\\s*\\("
        ]
      },
      "repairHint": "修复 UnityAds adapter 的 ready/viewable/sizeChange/CTA。",
      "autoRepair": false
    },
    {
      "id": "UNITY-STA-006",
      "title": "网络请求风险（Checker S11）",
      "stage": "static",
      "severity": "warning",
      "sourceClass": "checker-parity",
      "sourceVersion": "playable_check@8801:b1dbb2238ab331f6276d9b9ceed9d434054374d823de6869623f60a82082ed0a",
      "check": {
        "type": "regex_absent",
        "pattern": "\\bfetch\\s*\\(|\\bXMLHttpRequest\\b|\\bWebSocket\\s*\\("
      },
      "repairHint": "移除真实网络请求；GLSL 的 texelFetch 等非网络函数不应命中（本规则区分大小写）。",
      "autoRepair": false
    },
    {
      "id": "UNITY-MAN-001",
      "title": "Unity Ads Tester 验证",
      "stage": "manual",
      "severity": "manual",
      "sourceClass": "checker-parity",
      "sourceVersion": "playable_check@8801:b1dbb2238ab331f6276d9b9ceed9d434054374d823de6869623f60a82082ed0a",
      "check": {
        "type": "manual"
      },
      "repairHint": "使用 Unity Ads Tester 验证真实容器、关闭按钮和 Store ID Redirect。",
      "autoRepair": false,
      "manualGate": "使用 Unity Ads Tester 的 Playable URL Tester 完成最终验证。"
    }
  ]
}
