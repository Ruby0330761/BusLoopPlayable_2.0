{
  "schemaVersion": "playable-platform-rules-v1",
  "platform": "unityads",
  "rules": [
    {
      "id": "UNITY-ART-001",
      "title": "交付单个 HTML，禁止 ZIP",
      "stage": "artifact",
      "severity": "blocker",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "artifact_kind",
        "value": "html"
      },
      "repairHint": "使用 UnityAds HTML delivery 构建，不套 ZIP。",
      "autoRepair": false
    },
    {
      "id": "UNITY-ART-002",
      "title": "发布态 HTML 为单行",
      "stage": "artifact",
      "severity": "blocker",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "max_newlines",
        "value": 0
      },
      "repairHint": "在 UnityAds 构建步骤执行确定性 minify。",
      "autoRepair": false
    },
    {
      "id": "UNITY-ART-003",
      "title": "HTML 严格结束于 </html>",
      "stage": "artifact",
      "severity": "blocker",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "strict_html_end"
      },
      "repairHint": "删除 </html> 后的换行、空格、注释和工具标签。",
      "autoRepair": false
    },
    {
      "id": "UNITY-ART-004",
      "title": "除容器注入的唯一 mraid.js 声明外，业务内容全部自包含",
      "stage": "artifact",
      "severity": "blocker",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "self_contained_html",
        "allow": [
          "mraid.js",
          "./mraid.js"
        ]
      },
      "repairHint": "内联所有业务脚本、样式和资源，只保留精确的 mraid.js 或 ./mraid.js 容器声明；不得放宽其他 URL。",
      "autoRepair": false
    },
    {
      "id": "UNITY-STA-001",
      "title": "mraid.js 声明且仅一次",
      "stage": "static",
      "severity": "blocker",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "regex_count",
        "target": "main_html",
        "pattern": "<script\\b[^>]*\\bsrc\\s*=\\s*['\\\"](?:\\./)?mraid\\.js(?:[?#][^'\\\"]*)?['\\\"][^>]*>",
        "value": 1
      },
      "repairHint": "在 head 中保留唯一一次 mraid.js 声明。",
      "autoRepair": false
    },
    {
      "id": "UNITY-STA-002",
      "title": "MRAID 可见性与尺寸监听完整",
      "stage": "static",
      "severity": "blocker",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "all_regex_present",
        "patterns": [
          "mraid\\.getState\\s*\\(",
          "mraid\\.addEventListener",
          "['\\\"]ready['\\\"]",
          "['\\\"]viewableChange['\\\"]",
          "mraid\\.isViewable\\s*\\(",
          "['\\\"]sizeChange['\\\"]",
          "mraid\\.open\\s*\\("
        ]
      },
      "repairHint": "修复 UnityAds adapter 的 ready/viewable/sizeChange/CTA。",
      "autoRepair": false
    },
    {
      "id": "UNITY-STA-003",
      "title": "禁止 parent/top 容器探测",
      "stage": "static",
      "severity": "blocker",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "regex_absent",
        "pattern": "(?:window\\s*\\.\\s*)?(?:parent|top)\\s*\\.|(?:parent|top)\\s*\\[|parent\\.mraid|top\\.mraid"
      },
      "repairHint": "只访问 window.mraid，移除父窗口和顶层窗口探测。",
      "autoRepair": false
    },
    {
      "id": "UNITY-STA-004",
      "title": "禁止 AppLovin 残留",
      "stage": "static",
      "severity": "blocker",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "regex_absent",
        "pattern": "ALPlayableAnalytics|AppLovin|apl[_-]?event"
      },
      "repairHint": "从 UnityAds adapter 和模板中移除 AppLovin API 与说明。",
      "autoRepair": false
    },
    {
      "id": "UNITY-STA-005",
      "title": "禁止 AI 工具尾部标签",
      "stage": "static",
      "severity": "blocker",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "regex_absent",
        "pattern": "<\\/?(?:ai_title|ai_summary|ai_store_urls)\\b"
      },
      "repairHint": "修正导出器，禁止向最终 HTML 追加非标准标签。",
      "autoRepair": false
    },
    {
      "id": "UNITY-STA-006",
      "title": "禁止 Checker S11 命中的网络 API 字面量",
      "stage": "static",
      "severity": "blocker",
      "sourceClass": "checker-parity",
      "sourceVersion": "playable_check@86d58e33d293a0a095b574407a2d6c7d191d510f",
      "check": {
        "type": "regex_absent",
        "pattern": "(?:fetch\\s*\\(|\\bXMLHttpRequest\\b|WebSocket\\s*\\()"
      },
      "repairHint": "从源码、构建配置、模板或打包脚本消除网络 API 字面量并完整重建；Vite modulepreload polyfill 也必须在真实构建链关闭或替换，不得手改最终 HTML。",
      "autoRepair": false
    },
    {
      "id": "UNITY-MAN-001",
      "title": "Unity Ads Tester 验证",
      "stage": "manual",
      "severity": "manual",
      "sourceClass": "checker-parity",
      "sourceVersion": "playable_check@86d58e33d293a0a095b574407a2d6c7d191d510f",
      "check": {
        "type": "manual"
      },
      "repairHint": "使用 Unity Ads Tester 验证真实容器、关闭按钮和 Store ID Redirect。",
      "autoRepair": false,
      "manualGate": "使用 Unity Ads Tester 的 Playable URL Tester 完成最终验证。"
    }
  ]
}
