{
  "schemaVersion": "playable-platform-rules-v1",
  "platform": "mintegral",
  "rules": [
    {
      "id": "MINTEGRAL-ART-001",
      "title": "交付 ZIP",
      "stage": "artifact",
      "severity": "blocker",
      "sourceClass": "checker-parity",
      "sourceVersion": "playable_check@86d58e33d293a0a095b574407a2d6c7d191d510f",
      "check": {
        "type": "artifact_kind",
        "value": "zip"
      },
      "repairHint": "使用 Mintegral ZIP 构建入口。",
      "autoRepair": false
    },
    {
      "id": "MINTEGRAL-ART-002",
      "title": "ZIP 文件名格式建议（字母数字下划线）",
      "stage": "artifact",
      "severity": "warning",
      "sourceClass": "checker-parity",
      "sourceVersion": "playable_check@8801:b1dbb2238ab331f6276d9b9ceed9d434054374d823de6869623f60a82082ed0a",
      "check": {
        "type": "zip_name_regex",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "repairHint": "建议 ZIP 文件名只含字母、数字、下划线；官方可打开时可人工确认后台命名要求。",
      "autoRepair": true
    },
    {
      "id": "MINTEGRAL-ART-003",
      "title": "ZIP 入口结构（根层级或单目录主 HTML）",
      "stage": "artifact",
      "severity": "blocker",
      "sourceClass": "checker-parity",
      "sourceVersion": "playable_check@8801:b1dbb2238ab331f6276d9b9ceed9d434054374d823de6869623f60a82082ed0a",
      "check": {
        "type": "mintegral_structure"
      },
      "repairHint": "主 HTML 必须位于 ZIP 根层级或唯一子目录内。",
      "autoRepair": false
    },
    {
      "id": "MINTEGRAL-ART-004",
      "title": "资源引用完整",
      "stage": "artifact",
      "severity": "blocker",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "resource_references_exist",
        "allow": []
      },
      "repairHint": "修复相对路径并补齐 ZIP 资源。",
      "autoRepair": false
    },
    {
      "id": "MINTEGRAL-STA-001",
      "title": "禁止模块语法",
      "stage": "static",
      "severity": "blocker",
      "sourceClass": "checker-parity",
      "sourceVersion": "playable_check@86d58e33d293a0a095b574407a2d6c7d191d510f",
      "check": {
        "type": "regex_absent",
        "pattern": "type\\s*=\\s*['\\\"]module['\\\"]|import\\.meta|modulepreload|(^|[;{}\\n])\\s*import\\s+(?:[^(']|\\()"
      },
      "repairHint": "使用 classic/IIFE 构建并手动注入 production NODE_ENV。",
      "autoRepair": false
    },
    {
      "id": "MINTEGRAL-STA-002",
      "title": "生命周期函数真实可调用（严于 Checker S10）",
      "stage": "static",
      "severity": "blocker",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "global_functions",
        "names": [
          "install",
          "gameReady",
          "gameStart",
          "gameEnd",
          "gameClose",
          "gameRetry"
        ]
      },
      "repairHint": "在 classic 作用域真实暴露 window.install 与 gameReady/gameStart/gameEnd/gameClose/gameRetry。真实 Checker S10 只查字符串出现，本规则额外要求真实声明：仅有字面量而无可调用函数时运行时必定失败。",
      "autoRepair": false
    },
    {
      "id": "MINTEGRAL-STA-003",
      "title": "禁止在线外链",
      "stage": "static",
      "severity": "blocker",
      "sourceClass": "checker-parity",
      "sourceVersion": "playable_check@86d58e33d293a0a095b574407a2d6c7d191d510f",
      "check": {
        "type": "external_urls_allowlist",
        "allow": []
      },
      "repairHint": "把资源打进 ZIP，移除运行时网络请求。",
      "autoRepair": false
    },
    {
      "id": "MINTEGRAL-STA-004",
      "title": "禁止高风险投放态 API 残留",
      "stage": "static",
      "severity": "blocker",
      "sourceClass": "delivery-contract",
      "sourceVersion": "game_playable-playbook@8e26d3b61d52c7540809a3a56fb6821472cc14673c4943ca71ef97f851c8401b",
      "check": {
        "type": "regex_absent",
        "pattern": "\\bstructuredClone\\s*\\(|\\blocalStorage\\b|\\bBlob\\s*\\(|URL\\.(?:createObjectURL|revokeObjectURL)\\s*\\(|\\bResizeObserver\\b|Object\\.hasOwn\\s*\\(|\\bfetch\\s*\\(|\\bXMLHttpRequest\\b|console\\.error\\s*\\(|throw\\s+new\\s+Error|new\\s+Error\\s*\\("
      },
      "repairHint": "剥离 editor-only、上传下载、动态资源和旧 WebView 高风险分支。",
      "autoRepair": false
    },
    {
      "id": "MINTEGRAL-STA-005",
      "title": "禁止 crossorigin 属性",
      "stage": "static",
      "severity": "warning",
      "sourceClass": "checker-parity",
      "sourceVersion": "playable_check@86d58e33d293a0a095b574407a2d6c7d191d510f",
      "check": {
        "type": "regex_absent",
        "target": "main_html",
        "pattern": "<(?:img|audio|video|script|link|source|track|iframe|image)\\b[^>]*\\bcrossorigin"
      },
      "repairHint": "移除本地资源标签的 crossorigin 属性。",
      "autoRepair": false
    },
    {
      "id": "MINTEGRAL-STA-006",
      "title": "除 js/html 外不得以文件形式加载",
      "stage": "static",
      "severity": "warning",
      "sourceClass": "delivery-contract",
      "sourceVersion": "preview-util@mmp-cdn.rayjump.com/pt-scripts/preview-util.js",
      "check": {
        "type": "regex_absent",
        "target": "main_html",
        "pattern": "<(?:link|img|video|audio|source|track)\\b[^>]*\\b(?:href|src)\\s*=\\s*[\\\"'](?!data:)"
      },
      "repairHint": "建议把样式/图片/音视频内联进 HTML；Mindworks 检查器把单独加载的非 js 文件判为外链资源。",
      "autoRepair": false
    },
    {
      "id": "MINTEGRAL-MAN-001",
      "title": "Mindworks 完整生命周期复验",
      "stage": "manual",
      "severity": "manual",
      "sourceClass": "checker-parity",
      "sourceVersion": "playable_check@86d58e33d293a0a095b574407a2d6c7d191d510f",
      "check": {
        "type": "manual"
      },
      "repairHint": "在 Mindworks/PlayTurbo 完整试玩，确认 gameReady、gameStart、gameEnd、CTA 和结束页。",
      "autoRepair": false,
      "manualGate": "使用官方工具完成完整生命周期测试。"
    }
  ]
}
